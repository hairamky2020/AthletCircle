# All settings are optional. Copy to .env.local to override the defaults.
# They are read at build time (the site is a static export).

# Public site URL, used for canonical URLs, the sitemap and event schema.
NEXT_PUBLIC_SITE_URL=https://athletcircle.in

# Clearly labelled demo events. Set to false before launching with real events.
NEXT_PUBLIC_SHOW_DEMO=true

# Free map tiles from OpenFreeMap (no key, no sign-up).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Free road distance from the public OSRM server (by car, no live traffic).
# Leave empty to show straight-line distance only.
NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org

# Free address search from OpenStreetMap Nominatim (runs only when a visitor presses Search).
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org

# Where "List your event" submissions go.
NEXT_PUBLIC_CONTACT_EMAIL=events@athletcircle.in
# Optional form endpoint (for example a free Formspree form). Without it, the form opens an email.
NEXT_PUBLIC_SUBMIT_ENDPOINT=
