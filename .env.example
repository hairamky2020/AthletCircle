# All optional. Public values only (they end up in the browser). Never put secrets here.
NEXT_PUBLIC_SITE_URL=https://athletcircle.com
NEXT_PUBLIC_CONTACT_EMAIL=athletcircle@gmail.com

# Demo admin is off by default. Only local test builds set NEXT_PUBLIC_ENABLE_DEMO=1.
# Leave empty until the Supabase project exists
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets go in Supabase (Edge Function secrets), never here or in frontend code:
#   EMAIL_PROVIDER=brevo|resend   EMAIL_API_KEY=...   EMAIL_FROM="AthletCircle <events@athletcircle.com>"   SITE_URL=https://athletcircle.com
